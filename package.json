{
  "name": "booking-reservation-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "An easy-to-explain booking system: one server, one SQL file, and three frontend files.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "setup": "node backend/setup.js",
    "db:stop": "node backend/setup.js stop",
    "test": "node --test test.js"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.0.0"
  }
}
